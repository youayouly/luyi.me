# 复制成 .env.local 后填写。.env*.local 已在 .gitignore 里，不会被提交。
# 一个都不填也能跑：`npm run dev` 会得到一个完整的中英双语站，
# 只是发布/封面/访客统计/后台登录这几项功能关闭。

# ── 文章发布（/api/publish、/api/delete、/api/history）────────────────
# 这几个接口通过 GitHub Contents API 直接提交，不写本地工作区。
GITHUB_TOKEN=
GITHUB_REPO=your-name/your-repo
GITHUB_BRANCH=main

# ── 后台账号（/api/login 与所有写接口）──────────────────────────────
# 缺失时 /api/login 返回 500 并带 needsKv 提示，前端会显示"服务端未配置"
# 而不是"密码错误"。
LK_SITE_USER=
LK_SITE_PASS=

# ── Upstash Redis：后台会话 + 访客日志 ──────────────────────────────
# 由 Vercel Marketplace 集成注入；也接受 UPSTASH_REDIS_REST_URL/_TOKEN 别名。
# 缺失时 /api/visit 静默 no-op，浏览不受影响。
# ⚠️ 两个 Vercel 项目不要共用同一个实例：lk:admin:session 是单 key 单会话，
#    在 demo 站登录会把正式站踢下线。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── 访客日志的 IP 归属查询（`npm run sync:ip-asn`，非运行时变量）──────
# 免费申请：https://www.maxmind.com/en/geolite2/signup。只在本地/CI 跑那个
# 脚本时读一次，生成 lib/lk-ip-asn.generated.json；Vercel 上不需要配这个。
# 不配就跳过，访客判定少一条"IP 属于云主机网段"的信号，不影响其它功能。
MAXMIND_LICENSE_KEY=

# ── 翻译（/api/translate-page 运行时兜底）──────────────────────────
# 静态文案在构建期就翻好写进 /i18n/en.json，这个 key 只服务字典漏掉的字符串
# （天气、相对时间、刚发布的文章）。不填则那部分保持中文。
SILICONFLOW_API_KEY=
# 可选：换模型或换供应商。避免思考模式模型，慢约 10 倍。
TRANSLATE_MODEL=
TRANSLATE_API_BASE=
TRANSLATE_API_KEY=
TRANSLATE_ALLOWED_ORIGINS=

# ── AI 封面生成（/api/cover）──────────────────────────────────────
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=

# ── 其他 ─────────────────────────────────────────────────────────
# 页脚"已运行 X 年 X 天"的起算时刻；不设则用 site.config.js 里的 onlineSince。
LK_SITE_ONLINE_SINCE=
# 自定义发布接口地址（一般不用改）
LK_PUBLISH_API_URL=
# 额外允许调用 /api/visit 的来源
LK_VISIT_ALLOWED_ORIGINS=

# ── 留言板回复邮件提醒（/api/guestbook）─────────────────────────
# 两个都不填就不发信：留言照常存下，只是没有提醒。域名要先在 Resend 验证。
RESEND_API_KEY=
# 注意引号：值里带 <> 的话，不加引号 `set -a; . ./.env.local` 会把尖括号当重定向
LK_MAIL_FROM="Luke <onboarding@resend.dev>"
# 收「有人留言了」通知的地址；不填就不发这类通知（被回复的人照常收到提醒）
LK_MAIL_TO=
